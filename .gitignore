# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
.kotlin/

# Local configuration file (sdk path, signing secrets, etc)
local.properties
secrets.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
*.iml
.idea

# ---------------------------------------------------------------
# 签名文件永不入库。
# 口令通过 local.properties（本地）或环境变量（CI）提供，
# 详见 docs/NEW_PROJECT.md 的「签名配置」一节。
# ---------------------------------------------------------------
*.jks
*.keystore

# 例外：团队共用的 debug 证书必须入库，否则每台机器签名不一致。
# 它只是标准 Android Debug 证书，不含任何业务机密；release 密钥仍然禁止入库。
!app/keystore/debug.jks
!app/keystore/README.md

# MacOS
.DS_Store

.externalNativeBuild
.cxx

# 本地 AI 协作目录（会话记忆等），不入库
.workbuddy/
