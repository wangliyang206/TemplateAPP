<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：
  - 默认禁止明文流量
  - 生产域名开启证书固定（把 <pin-set> 换成真实证书指纹后启用）
  - debug 变体由 src/debug/AndroidManifest.xml 单独放开明文
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
    <domain-config>
