<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup=false 时该文件不参与备份，保留占位以便日后开启云备份时按需配置规则。
  Token 等敏感数据存于 DataStore，默认不允许备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
