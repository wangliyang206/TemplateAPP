<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="CoreTheme">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- 启动页基础样式：存放 minSdk 24 即可用的属性 -->
    <style name="AppTheme.Splash.Base" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/splash_window_bg</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 去掉启动瞬间的系统动画与预览窗口 -->
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="AppTheme.Splash" parent="AppTheme.Splash.Base" />
</resources>
