<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="CoreTheme">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="AppTheme.Splash" parent="AppTheme">
        <!-- 原有配置保留 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/splash_window_bg</item>
        <!--<item name="android:windowBackground">@mipmap/icon_group</item>-->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 新增/强化动画禁用 -->
        <item name="android:windowAnimationStyle">@android:style/Animation</item> <!-- 空动画 -->
        <item name="android:windowDisablePreview">true</item> <!-- 禁用预览窗口 -->
        <item name="android:activityOpenEnterAnimation">@null</item> <!-- 禁用Activity进入动画 -->
        <item name="android:activityCloseExitAnimation">@null</item> <!-- 禁用Activity退出动画 -->
        <item name="android:windowEnterAnimation">@null</item> <!-- 禁用窗口进入动画 -->
        <item name="android:windowExitAnimation">@null</item> <!-- 禁用窗口退出动画 -->
    </style>
</resources>
