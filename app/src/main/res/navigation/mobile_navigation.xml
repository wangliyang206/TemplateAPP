<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.template.app.ui.home.HomeFragment"
        android:label="@string/tab_home">
        <action
            android:id="@+id/action_homeFragment_to_listFragment"
            app:destination="@id/listFragment" />
    </fragment>

    <fragment
        android:id="@+id/listFragment"
        android:name="com.template.app.ui.list.ListFragment"
        android:label="列表示例" />

    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.template.app.ui.category.CategoryFragment"
        android:label="@string/tab_category" />

    <fragment
        android:id="@+id/mineFragment"
        android:name="com.template.app.ui.mine.MineFragment"
        android:label="@string/tab_mine" />
</navigation>
