<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/homeFragment">

    <!-- 底部导航的四个一级页面 -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.template.app.ui.home.HomeFragment"
        android:label="@string/tab_home">

        <!-- 搜索页不是底部导航项，只能从资讯页标题栏进入，所以用 action 显式声明跳转 -->
        <action
            android:id="@+id/action_home_to_search"
            app:destination="@id/searchFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.template.app.ui.discover.DiscoverFragment"
        android:label="@string/tab_discover">

        <action
            android:id="@+id/action_discover_to_category_article"
            app:destination="@id/categoryArticleFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/messageFragment"
        android:name="com.template.app.ui.message.MessageFragment"
        android:label="@string/tab_message" />

    <fragment
        android:id="@+id/mineFragment"
        android:name="com.template.app.ui.mine.MineFragment"
        android:label="@string/tab_mine">

        <action
            android:id="@+id/action_mine_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_mine_to_favorite"
            app:destination="@id/favoriteFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_mine_to_history"
            app:destination="@id/historyFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!--
      以下是二级页面，不在 bottom_nav_menu.xml 里：
      靠 action 进入，进入时 MainActivity 会隐藏底部导航（见 addOnDestinationChangedListener）。
    -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.template.app.ui.search.SearchFragment"
        android:label="@string/search_title" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.template.app.ui.settings.SettingsFragment"
        android:label="@string/settings_title" />

    <fragment
        android:id="@+id/categoryArticleFragment"
        android:name="com.template.app.ui.categoryarticle.CategoryArticleFragment"
        android:label="@string/tab_category" />

    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.template.app.ui.favorite.FavoriteFragment"
        android:label="@string/favorite_title" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.template.app.ui.history.HistoryFragment"
        android:label="@string/history_title" />
</navigation>
